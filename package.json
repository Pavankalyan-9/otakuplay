{
  "name": "otakuplay",
  "version": "1.0.0",
  "description": "Ranked collection of the best anime and PC games, by era.",
  "scripts": {
    "build": "node scripts/build-vendor.mjs && eleventy",
    "dev": "node scripts/build-vendor.mjs && eleventy --serve --port=5173",
    "serve": "http-server _site -p 5173 -c-1",
    "test": "npm run build && playwright test",
    "test:ui": "playwright test --ui",
    "art": "node scripts/fetch-art.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pavankalyan-9/otakuplay.git"
  },
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Pavankalyan-9/otakuplay/issues"
  },
  "homepage": "https://github.com/Pavankalyan-9/otakuplay#readme",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "esbuild": "^0.28.2",
    "http-server": "^14.1.1",
    "jsqr": "^1.4.0"
  },
  "private": true,
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
