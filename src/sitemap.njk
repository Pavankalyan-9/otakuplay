---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
{#- Built from the catalogue directly: paginated entry pages don't reliably land
    in collections.all, and a sitemap silently missing 219 URLs is worse than no
    sitemap at all. A test asserts the count. -#}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for path in ['', 'anime/', 'games/', 'insights/', 'about/'] %}
  <url>
    <loc>{{ path | absoluteUrl(site.url) }}</loc>
    <changefreq>weekly</changefreq>
    <priority>{{ '1.0' if path == '' else '0.8' }}</priority>
  </url>
{%- endfor %}
{%- for hub in hubs.all %}
  <url>
    <loc>{{ hub.url | absoluteUrl(site.url) }}</loc>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
{%- endfor %}
{%- for entry in catalogue.entries %}
  <url>
    <loc>{{ entry.url | absoluteUrl(site.url) }}</loc>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
{%- endfor %}
</urlset>
